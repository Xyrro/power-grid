# Copied to $PGU_ROOT/pgu.conf by pgu_setup.sh. KEY=VALUE, read by pgu_guard.py.
# The values below were read from PACE ICE (login-ice, October 2026) with `pgu_guard.py status`:
#   account coc; partitions ice-cpu (18:00:00) and ice-gpu (16:00:00, GPU types h100 h200 l40s a100 a40 v100
#   rtx_6000 mi210); QOS coc-ice / coe-ice with MaxTRESRunMinsPU gres/gpu=1920 (= 32 GPU-hours) and MaxSubmitPU 50.
# Re-check them with `pgu_guard.py status` if the cluster changes.
JOB_PREFIX=pgu-
ACCOUNT=coc
GPU_PARTITION=coe-gpu   # 18x8 h100 + 18x8 h200; ice-gpu is the fallback (6x8 each)
CPU_PARTITION=ice-cpu
QOS=coc-ice             # fallback
GPU_QOS=coe-ice         # coe-gpu needs coe-ice (shorter queue: ~13 h vs ~22 h on ice-gpu, Oct 2026)
CPU_QOS=coc-ice
GPU_GRES=gpu:h100       # or gpu:h200 / gpu:l40s / gpu:a100; plain `gpu` takes whatever is free
PYTHON_MODULE=python/3.11.9
CUDA_MODULE=            # not needed: the torch wheel ships its own CUDA runtime

# Cluster per-user limits (shared with your other projects). The guard refuses anything that would exceed them.
USER_GPU_HOURS_LIMIT=32 # QOS MaxTRESRunMinsPU gres/gpu=1920 minutes: sum of GPUs x walltime over running jobs
USER_GPU_JOBS_LIMIT=50  # QOS MaxSubmitPU: GPU jobs queued + running

# This project's share of those limits. Pending jobs count in full, so the share holds once they start.
SHARE_GPU_HOURS=16
SHARE_GPU_JOBS=4
SHARE_CPU_TASKS=16
SHARE_CPU_CONCURRENT=8
MAX_WALLTIME=08:00:00       # GPU jobs (partition allows 16:00:00; shorter jobs free the GPU-hour budget sooner)
MAX_WALLTIME_CPU=18:00:00   # CPU jobs (partition limit)
